<!DOCTYPE html>
<html lang="uz" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Maktab — Universal Maktab Ta'lim Portali</title>
    <!-- Zamonaviy uslublar uchun Tailwind CSS va FontAwesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .gradient-brand {
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #06b6d4 100%);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 flex flex-col min-h-screen">

    <!-- 1. NAVIGATION BAR -->
    <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <!-- Logotip -->
                <div class="flex items-center space-x-3 cursor-pointer" onclick="scrollToSection('bosh-sahifa')">
                    <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white text-xl font-bold shadow-md shadow-blue-500/30">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <div>
                        <span class="text-xl font-extrabold bg-gradient-to-r from-blue-700 to-cyan-600 bg-clip-text text-transparent">AI Maktab</span>
                        <span class="block text-[10px] font-semibold text-slate-400 tracking-wider uppercase">Milliy ta'lim portali</span>
                    </div>
                </div>

                <!-- Asosiy menyu (Desktop) -->
                <div class="hidden lg:flex space-x-1 font-medium text-sm text-slate-600">
                    <button onclick="scrollToSection('fanlar')" class="px-3 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50 transition">Fanlar</button>
                    <button onclick="scrollToSection('ai-ustoz')" class="px-3 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50 transition">AI Ustoz & Masalalar</button>
                    <button onclick="scrollToSection('testlar')" class="px-3 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50 transition">Testlar</button>
                    <button onclick="scrollToSection('reja')" class="px-3 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50 transition">Imtihon rejasi</button>
                    <button onclick="scrollToSection('natijalar')" class="px-3 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50 transition">Natijalar</button>
                    <button onclick="scrollToSection('tariflar')" class="px-3 py-2 rounded-lg hover:text-blue-600 hover:bg-blue-50 transition">Tariflar</button>
                </div>

                <!-- Ball / XP va Sozlamalar -->
                <div class="flex items-center space-x-3">
                    <div class="bg-amber-100 text-amber-800 text-xs px-3 py-1.5 rounded-full font-bold flex items-center gap-1.5 shadow-sm" title="Sizning to'plagan ballaringiz">
                        <i class="fa-solid fa-bolt text-amber-500"></i>
                        <span id="user-xp">0</span> XP
                    </div>
                    <button onclick="toggleModal('api-modal')" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-lg border border-slate-300 font-semibold" title="AI Modeli sozlamasi">
                        <i class="fa-solid fa-sliders mr-1"></i> Sozlash
                    </button>
                    <button onclick="toggleMobileMenu()" class="lg:hidden text-slate-700 text-xl p-1.5">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobil Menyu -->
        <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-2 text-sm font-medium">
            <button onclick="scrollToSection('fanlar'); toggleMobileMenu()" class="block w-full text-left py-2 text-slate-700">Fanlar va Sinflar</button>
            <button onclick="scrollToSection('ai-ustoz'); toggleMobileMenu()" class="block w-full text-left py-2 text-slate-700">AI Ustoz va Masalalar</button>
            <button onclick="scrollToSection('testlar'); toggleMobileMenu()" class="block w-full text-left py-2 text-slate-700">Testlar va Baholash</button>
            <button onclick="scrollToSection('reja'); toggleMobileMenu()" class="block w-full text-left py-2 text-slate-700">Imtihon Tayyorgarligi</button>
            <button onclick="scrollToSection('natijalar'); toggleMobileMenu()" class="block w-full text-left py-2 text-slate-700">Natijalarim</button>
            <button onclick="scrollToSection('tariflar'); toggleMobileMenu()" class="block w-full text-left py-2 text-slate-700">Tariflar</button>
        </div>
    </nav>

    <!-- ASOSIY QISM -->
    <main class="flex-grow">

        <!-- 2. HERO BO'LIMI -->
        <section id="bosh-sahifa" class="gradient-brand text-white py-14 lg:py-20 relative overflow-hidden">
            <div class="max-w-6xl mx-auto px-4 text-center space-y-6">
                <span class="inline-block py-1 px-4 bg-white/20 backdrop-blur-md rounded-full text-xs font-semibold uppercase tracking-wider text-cyan-200">
                    O'zbekiston maktablari uchun 100% o'zbek tilida
                </span>
                <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight">
                    O'qishda eng yaqin yordamchingiz — <br class="hidden sm:inline"><span class="text-cyan-300">Aqlli AI Maktab</span>
                </h1>
                <p class="max-w-2xl mx-auto text-blue-100 text-sm sm:text-base leading-relaxed">
                    Murakkab formulalar, darslikdagi masalalar va uy vazifalarini bosqichma-bosqich, eng sodda tilda o'rganing. Bepul testlar bilan o'z bilimingizni sinang!
                </p>
                <div class="flex flex-wrap justify-center gap-3 pt-2">
                    <button onclick="scrollToSection('ai-ustoz')" class="bg-white text-blue-900 hover:bg-slate-100 font-bold px-6 py-3 rounded-xl shadow-lg transition flex items-center gap-2">
                        <i class="fa-solid fa-robot text-blue-600"></i> AI Ustoztan so'rash
                    </button>
                    <button onclick="scrollToSection('testlar')" class="bg-blue-800/60 hover:bg-blue-800 text-white border border-white/30 font-bold px-6 py-3 rounded-xl transition flex items-center gap-2">
                        <i class="fa-solid fa-circle-check"></i> Test topshirish
                    </button>
                </div>
            </div>
        </section>

        <!-- 3. FANLAR VA MAVZULAR BO'LIMI -->
        <section id="fanlar" class="py-12 bg-white border-b border-slate-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-2xl mx-auto mb-8">
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">9 ta Asosiy Maktab Fani</h2>
                    <p class="text-slate-500 mt-2 text-sm">O'zingizga kerakli sinf va fanni tanlang, mavzular bilan tanishing.</p>
                </div>

                <!-- Sinf filtrlari -->
                <div class="flex items-center justify-center flex-wrap gap-2 mb-8">
                    <span class="text-xs font-bold text-slate-400 mr-2 uppercase">Sinf:</span>
                    <div id="grade-buttons" class="flex flex-wrap gap-1.5 justify-center"></div>
                </div>

                <!-- Fanlar gridi -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="subjects-grid"></div>

                <!-- Tanlangan fanning mavzulari modali / ochiladigan paneli -->
                <div id="subject-topic-panel" class="hidden mt-8 p-6 bg-slate-50 rounded-2xl border border-blue-200 transition">
                    <div class="flex justify-between items-center mb-4">
                        <h3 id="panel-title" class="text-lg font-bold text-blue-900"></h3>
                        <button onclick="closeTopicPanel()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
                    </div>
                    <div id="topics-container" class="space-y-3"></div>
                </div>
            </div>
        </section>

        <!-- 4. AI USTOZ VA BOSQICHMA-BOSQICH MASALA YECHISH -->
        <section id="ai-ustoz" class="py-12 bg-slate-100 border-b border-slate-200">
            <div class="max-w-4xl mx-auto px-4 sm:px-6">
                <div class="text-center max-w-2xl mx-auto mb-8">
                    <span class="text-blue-600 font-bold text-xs uppercase tracking-wider">Virtual Repetitor</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">AI Ustoz va Masalalar Yechuvchi</h2>
                    <p class="text-slate-500 mt-2 text-sm">Formulalar, uy vazifalari va dars mavzulari bo'yicha savol bering yoki qadam-baqadam yechim oling.</p>
                </div>

                <!-- Rejimlar (Tablar) -->
                <div class="flex border-b border-slate-200 mb-4 bg-white rounded-t-xl overflow-hidden p-1 gap-1">
                    <button onclick="switchAiTab('chat')" id="tab-btn-chat" class="flex-1 py-2.5 text-xs sm:text-sm font-bold text-blue-600 bg-blue-50 rounded-lg flex items-center justify-center gap-2">
                        <i class="fa-solid fa-comments"></i> Erkin Savol-Javob
                    </button>
                    <button onclick="switchAiTab('solver')" id="tab-btn-solver" class="flex-1 py-2.5 text-xs sm:text-sm font-bold text-slate-600 hover:text-blue-600 rounded-lg flex items-center justify-center gap-2">
                        <i class="fa-solid fa-calculator"></i> Bosqichma-bosqich Yechuvchi
                    </button>
                    <button onclick="switchAiTab('homework')" id="tab-btn-homework" class="flex-1 py-2.5 text-xs sm:text-sm font-bold text-slate-600 hover:text-blue-600 rounded-lg flex items-center justify-center gap-2">
                        <i class="fa-solid fa-book-open"></i> Uy Vazifasiga Yordam
                    </button>
                </div>

                <!-- 1-TAB: AI Chat -->
                <div id="tab-chat" class="bg-white rounded-b-xl shadow-lg border border-slate-200 flex flex-col h-[520px]">
                    <div class="p-3 bg-slate-900 text-white flex justify-between items-center text-xs">
                        <div class="flex items-center space-x-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span class="font-bold">AI Ustoz faol</span>
                            <span id="active-engine-badge" class="bg-slate-800 text-cyan-300 px-2 py-0.5 rounded text-[10px]">Oflayn Milliy Baza</span>
                        </div>
                        <button onclick="clearChat()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-rotate-right mr-1"></i> Tozalash</button>
                    </div>

                    <div id="chat-box" class="flex-grow p-4 overflow-y-auto space-y-3 bg-slate-50/50 text-sm">
                        <!-- AI Dastlabki salomlashishi -->
                        <div class="flex items-start gap-2.5">
                            <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-bold shrink-0">AI</div>
                            <div class="bg-white p-3.5 rounded-2xl rounded-tl-none border border-slate-200 text-slate-800 max-w-[85%] shadow-sm leading-relaxed">
                                Salom, aziz o'quvchi! Men AI Maktabning shaxsiy ustoziman. Qaysi fandan savolingiz bor? Quyidagi namuna tugmalardan birini bosib ko'rishingiz mumkin:
                                <div class="flex flex-wrap gap-1.5 mt-3">
                                    <button onclick="askPrompt('Nyutonning ikkinchi qonuni nima?')" class="text-xs bg-blue-50 text-blue-700 hover:bg-blue-100 px-2.5 py-1 rounded-md border border-blue-200">Nyuton 2-qonuni</button>
                                    <button onclick="askPrompt('Fotosintez qanday sodir bo\'ladi?')" class="text-xs bg-emerald-50 text-emerald-700 hover:bg-emerald-100 px-2.5 py-1 rounded-md border border-emerald-200">Fotosintez</button>
                                    <button onclick="askPrompt('Egalik qo\'shimchalari qaysilar?')" class="text-xs bg-amber-50 text-amber-700 hover:bg-amber-100 px-2.5 py-1 rounded-md border border-amber-200">Egalik qo'shimchalari</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form onsubmit="handleChatSubmit(event)" class="p-3 border-t border-slate-200 bg-white flex gap-2">
                        <input id="chat-input" type="text" placeholder="Savolingizni yoki tushunmagan mavzuingizni yozing..." class="flex-grow border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-bold text-sm shadow transition">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </form>
                </div>

                <!-- 2-TAB: Masalani bosqichma-bosqich yechish -->
                <div id="tab-solver" class="hidden bg-white p-6 rounded-b-xl shadow-lg border border-slate-200 space-y-4">
                    <h4 class="font-bold text-slate-800 text-base">Aniq fanlar bo'yicha bosqichma-bosqich tahlil</h4>
                    <p class="text-xs text-slate-500">Matematika, fizika yoki kimyodan masalani yoki tenglamani kiriting. Tizim uni bosqichlarga ajratib ko'rsatadi.</p>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <input id="solver-input" type="text" placeholder="Masalan: 2x + 10 = 30 yoki F = 20N, m = 4kg, a = ?" class="sm:col-span-2 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                        <button onclick="solveProblem()" class="bg-cyan-600 hover:bg-cyan-700 text-white font-bold rounded-xl px-4 py-2.5 text-sm transition">
                            <i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Bosqichma-bosqich yech
                        </button>
                    </div>

                    <!-- Tayyor namunalar -->
                    <div class="text-xs flex items-center gap-2 text-slate-500">
                        <span>Namunalar:</span>
                        <button onclick="setSolverSample('3x - 15 = 0')" class="text-blue-600 underline">3x - 15 = 0</button>
                        <button onclick="setSolverSample('m=5kg, a=3m/s^2, F=?')" class="text-blue-600 underline">Kuchni topish</button>
                        <button onclick="setSolverSample('H2O molyar massasi')" class="text-blue-600 underline">Suvning molyar massasi</button>
                    </div>

                    <div id="solver-output" class="hidden p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3 mt-4 text-sm"></div>
                </div>

                <!-- 3-TAB: Uy vazifasini tushunishga yordam -->
                <div id="tab-homework" class="hidden bg-white p-6 rounded-b-xl shadow-lg border border-slate-200 space-y-4">
                    <h4 class="font-bold text-slate-800 text-base">Uy vazifasini tushunib ishlash</h4>
                    <p class="text-xs text-slate-500">Uy vazifasidagi qaysi qismga tushunmayapsiz? Masalani shartini yozing, AI sizga tayyor javobni emas, balki <strong class="text-slate-700">yechish mantiqi va qoidasini</strong> tushuntiradi.</p>
                    
                    <textarea id="hw-input" rows="3" placeholder="Masalan: 7-sinf ingliz tili 'Present Perfect' bo'yicha gap tuzish qoidasini tushunmayapman..." class="w-full border border-slate-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
                    
                    <button onclick="helpHomework()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl px-5 py-2.5 text-sm transition">
                        <i class="fa-solid fa-lightbulb mr-1"></i> Yechish yo'lini tushuntir
                    </button>

                    <div id="hw-output" class="hidden p-4 rounded-xl bg-indigo-50/50 border border-indigo-200 space-y-2 text-sm text-slate-800"></div>
                </div>
            </div>
        </section>

        <!-- 5. TESTLAR VA BILIMNI TEKSHIRISH BO'LIMI -->
        <section id="testlar" class="py-12 bg-white border-b border-slate-200">
            <div class="max-w-4xl mx-auto px-4 sm:px-6">
                <div class="text-center max-w-2xl mx-auto mb-8">
                    <span class="text-blue-600 font-bold text-xs uppercase tracking-wider">Avtomatik Baholash</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Interaktiv Fan Testlari</h2>
                    <p class="text-slate-500 mt-2 text-sm">Fanni tanlang, savollarga javob bering, natijalarni va ballarni darhol oling.</p>
                </div>

                <!-- Test fanini tanlash -->
                <div class="flex flex-wrap justify-center gap-2 mb-6" id="test-subjects"></div>

                <!-- Test kartasi -->
                <div id="quiz-card" class="bg-slate-50 p-6 rounded-2xl border border-slate-200 shadow-md">
                    <div class="flex justify-between items-center pb-4 mb-4 border-b border-slate-200">
                        <div>
                            <span id="quiz-subject-badge" class="bg-blue-100 text-blue-800 text-xs font-bold px-2.5 py-1 rounded-md">Matematika</span>
                            <span id="quiz-step" class="text-xs text-slate-500 ml-2">Savol 1 / 3</span>
                        </div>
                        <span class="text-xs font-bold text-emerald-600"><i class="fa-solid fa-award mr-1"></i>+20 XP har bir to'g'ri javobga</span>
                    </div>

                    <h3 id="quiz-question" class="text-base sm:text-lg font-bold text-slate-800 mb-4">Savol matni yuklanmoqda...</h3>

                    <div id="quiz-options" class="space-y-2.5 mb-6"></div>

                    <div id="quiz-explanation" class="hidden p-3 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 mb-4"></div>

                    <div class="flex justify-between items-center">
                        <button id="quiz-check-btn" onclick="checkCurrentAnswer()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-2.5 rounded-xl text-sm transition">
                            Tekshirish
                        </button>
                        <button id="quiz-next-btn" onclick="nextQuestion()" class="hidden bg-slate-900 hover:bg-slate-800 text-white font-bold px-5 py-2.5 rounded-xl text-sm transition">
                            Keyingi savol <i class="fa-solid fa-arrow-right ml-1"></i>
                        </button>
                    </div>
                </div>

                <!-- Test Yakuni xabari -->
                <div id="quiz-result-box" class="hidden bg-emerald-50 border border-emerald-200 rounded-2xl p-6 text-center space-y-4">
                    <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-2xl mx-auto font-bold">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <h3 class="text-xl font-extrabold text-emerald-900">Test muvaffaqiyatli yakunlandi!</h3>
                    <p id="quiz-score-text" class="text-sm text-emerald-700"></p>
                    <button onclick="restartQuiz()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-2.5 rounded-xl text-sm transition">
                        Qaytadan topshirish
                    </button>
                </div>
            </div>
        </section>

        <!-- 6. IMTIHON TAYYORGARLIK REJASI GENERATORI -->
        <section id="reja" class="py-12 bg-slate-100 border-b border-slate-200">
            <div class="max-w-4xl mx-auto px-4 sm:px-6">
                <div class="text-center max-w-2xl mx-auto mb-8">
                    <span class="text-blue-600 font-bold text-xs uppercase tracking-wider">Rejali Ta'lim</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Imtihonga Shaxsiy Tayyorgarlik Rejasi</h2>
                    <p class="text-slate-500 mt-2 text-sm">Imtihongacha qancha vaqtingiz borligini ko'rsating, AI tizimi sizga har kungi o'quv rejasini tuzib beradi.</p>
                </div>

                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Asosiy imtihon fani:</label>
                            <select id="plan-subject" class="w-full border border-slate-300 rounded-xl p-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                                <option value="Matematika">Matematika</option>
                                <option value="Fizika">Fizika</option>
                                <option value="Ona tili va Adabiyot">Ona tili va Adabiyot</option>
                                <option value="Ingliz tili">Ingliz tili</option>
                                <option value="Kimyo">Kimyo</option>
                                <option value="Biologiya">Biologiya</option>
                                <option value="Tarix">Tarix</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Qolgan muddat (kun):</label>
                            <input id="plan-days" type="number" min="3" max="60" value="7" class="w-full border border-slate-300 rounded-xl p-2.5 text-sm focus:ring-2 focus:ring-blue-500 outline-none">
                        </div>
                    </div>

                    <button onclick="generatePlan()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl text-sm transition">
                        <i class="fa-solid fa-calendar-check mr-2"></i> Shaxsiy Rejani Tuzish
                    </button>

                    <div id="plan-result" class="hidden mt-4 pt-4 border-t border-slate-200 space-y-3"></div>
                </div>
            </div>
        </section>

        <!-- 7. O'QUV NATIJALARINI KUZATISH (STATISTIKA) -->
        <section id="natijalar" class="py-12 bg-white border-b border-slate-200">
            <div class="max-w-5xl mx-auto px-4 sm:px-6">
                <div class="text-center max-w-2xl mx-auto mb-8">
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Mening O'quv Natijalarim</h2>
                    <p class="text-slate-500 mt-2 text-sm">Barcha yechilgan testlar va erishilgan marralar brauzeringizda xavfsiz saqlanadi.</p>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
                    <div class="bg-blue-50 border border-blue-200 p-4 rounded-xl text-center">
                        <div class="text-2xl font-extrabold text-blue-700" id="stat-xp">0</div>
                        <div class="text-xs text-blue-900 font-semibold mt-1">Jami Ball (XP)</div>
                    </div>
                    <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-xl text-center">
                        <div class="text-2xl font-extrabold text-emerald-700" id="stat-tests">0</div>
                        <div class="text-xs text-emerald-900 font-semibold mt-1">Tugallangan Testlar</div>
                    </div>
                    <div class="bg-cyan-50 border border-cyan-200 p-4 rounded-xl text-center">
                        <div class="text-2xl font-extrabold text-cyan-700" id="stat-accuracy">0%</div>
                        <div class="text-xs text-cyan-900 font-semibold mt-1">O'rtacha Aniqlik</div>
                    </div>
                    <div class="bg-amber-50 border border-amber-200 p-4 rounded-xl text-center">
                        <div class="text-2xl font-extrabold text-amber-700" id="stat-level">1-daraja</div>
                        <div class="text-xs text-amber-900 font-semibold mt-1">O'quvchi Martabasi</div>
                    </div>
                </div>

                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5">
                    <div class="flex justify-between items-center mb-4">
