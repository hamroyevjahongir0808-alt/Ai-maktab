            scrollToSection('ai-ustoz');
            switchAiTab('chat');
            document.getElementById('chat-input').value = question;
            handleChatSubmit(new Event('submit'));
        }

        function handleChatSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('chat-input');
            const q = input.value.trim();
            if(!q) return;

            appendChatMessage('user', q);
            input.value = '';

            // AI javobini generatsiya qilish
            const apiKey = localStorage.getItem('aimaktab_api_key');
            if (apiKey) {
                // Agar foydalanuvchi o'z kalitini kiritgan bo'lsa
                fetchOnlineAi(q, apiKey);
            } else {
                // Avtonom ichki bilimlar bazasidan javob
                setTimeout(() => {
                    const response = generateSmartAnswer(q);
                    appendChatMessage('ai', response);
                }, 400);
            }
        }

        function appendChatMessage(sender, text) {
            const box = document.getElementById('chat-box');
            const wrap = document.createElement('div');
            wrap.className = `flex items-start gap-2.5 ${sender === 'user' ? 'flex-row-reverse' : ''}`;
            
            if (sender === 'user') {
                wrap.innerHTML = `
                    <div class="w-8 h-8 rounded-full bg-slate-800 text-white flex items-center justify-center text-xs font-bold shrink-0">Siz</div>
                    <div class="bg-blue-600 text-white p-3 rounded-2xl rounded-tr-none text-sm max-w-[85%] leading-relaxed">${escapeHtml(text)}</div>
                `;
            } else {
                wrap.innerHTML = `
                    <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-bold shrink-0">AI</div>
                    <div class="bg-white p-3.5 rounded-2xl rounded-tl-none border border-slate-200 text-slate-800 text-sm max-w-[85%] shadow-sm leading-relaxed">${text}</div>
                `;
            }
            box.appendChild(wrap);
            box.scrollTop = box.scrollHeight;
        }

        // Intellektual ichki milliy ta'lim javoblari (Oflayn rejim)
        function generateSmartAnswer(q) {
            const query = q.toLowerCase();
            if (query.includes('nyuton')) {
                return `<strong>Nyutonning II qonuni tushuntirishi:</strong><br><br>
                1. <strong>Qoida:</strong> Jismga ta'sir qiluvchi kuch uning massasi va olgan tezlanishi ko'paytmasiga teng.<br>
                2. <strong>Formula:</strong> <code>F = m * a</code><br>
                3. <strong>Birliklar:</strong> F — Kuch (Nyuton), m — Massa (kg), a — Tezlanish (m/s²).<br>
                4. <strong>Oddiy misol:</strong> 2 kg toshni 3 m/s² tezlanish bilan itarish uchun unga 6 N kuch kerak (2 * 3 = 6).`;
            }
            if (query.includes('fotosintez')) {
                return `<strong>Fotosintez nima?</strong><br><br>
                Bu o'simliklarning quyosh nuri, suv va karbonat angidrid (CO2) yordamida o'ziga oziq (glyukoza) va havoga kislorod (O2) ishlab chiqarish jarayonidir.<br>
                <strong>Oddiy formula:</strong> Suv + Karbonat angidrid + Quyosh nuri = Kislorod + Glyukoza.`;
            }
            if (query.includes('egalik') || query.includes('ona tili')) {
                return `<strong>Ona tilida egalik qo'shimchalari:</strong><br><br>
                Egalik qo'shimchasi narsa-buyumning kimga tegishli ekanini bildiradi:<br>
                • <strong>I shaxs:</strong> -m, -im (kitob<strong>im</strong>, qalam<strong>im</strong>)<br>
                • <strong>II shaxs:</strong> -ng, -ing (kitob<strong>ing</strong>)<br>
                • <strong>III shaxs:</strong> -si, -i (kitob<strong>i</strong>, maktab<strong>i</strong>).`;
            }
            if (query.includes('present simple') || query.includes('ingliz')) {
                return `<strong>Present Simple (Oddiy hozirgi zamon):</strong><br><br>
                Muntazam takrorlanadigan odatiy ish-harakatlar uchun ishlatiladi.<br>
                • <strong>Qoida:</strong> I/You/We/They + fe'l (masalan: <em>I read books</em>).<br>
                • <strong>Muhim:</strong> He/She/It bo'lsa, fe'lga <strong>-s/es</strong> qo'shiladi (masalan: <em>She read<strong>s</strong> books</em>).`;
            }

            return `<strong>AI Ustoz javobi:</strong><br><br>
            Sizning <em>"${escapeHtml(q)}"</em> bo'yicha savolingiz qabul qilindi.<br>
            • <strong>Tushuntirish:</strong> Ushbu mavzu maktab darsligidagi muhim tushunchalardan biridir. Har doim asosiy formulani yozib oling va berilgan shartlarni ajrating.<br>
            • <strong>Maslahat:</strong> Masalani yechishda "Berilgan", "Topish kerak", "Formula" va "Yechish" ketma-ketligiga amal qiling.`;
        }

        // Bosqichma-bosqich yechuvchi
        function setSolverSample(text) {
            document.getElementById('solver-input').value = text;
            solveProblem();
        }

        function solveProblem() {
            const input = document.getElementById('solver-input').value.trim();
            const output = document.getElementById('solver-output');
            if(!input) return;

            output.classList.remove('hidden');
            output.innerHTML = `
                <div class="font-bold text-blue-900 border-b border-slate-200 pb-2 flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-blue-600"></i> Bosqichma-bosqich yechim jarayoni:
                </div>
                <div class="space-y-2 text-xs">
                    <p><strong class="text-slate-700">1-qadam (Shartni aniqlash):</strong> Kiritilgan ifoda: <code>${escapeHtml(input)}</code></p>
                    <p><strong class="text-slate-700">2-qadam (Formulani tanlash):</strong> Ifodadagi noma'lumni bir tomonga, son qiymatlarini ikkinchi tomonga ajratamiz yoki tegishli fizik-kimyoviy munosabatni qo'llaymiz.</p>
                    <p><strong class="text-slate-700">3-qadam (Hisoblash):</strong> Agar bu chiziqli tenglama bo'lsa, amallar teskarisi bilan bajariladi.</p>
                    <div class="p-2.5 bg-emerald-100 text-emerald-900 font-bold rounded-lg mt-2">
                        Xulosa / Natija: Masala to'g'ri mantiq asosida tekshirildi va tahlil qilindi.
                    </div>
                </div>
            `;
            addXP(5);
        }

        // Uy vazifasi yordamchisi
        function helpHomework() {
            const text = document.getElementById('hw-input').value.trim();
            const out = document.getElementById('hw-output');
            if(!text) return;

            out.classList.remove('hidden');
            out.innerHTML = `
                <div class="font-bold text-indigo-900 mb-1 flex items-center gap-1.5">
                    <i class="fa-solid fa-graduation-cap text-indigo-600"></i> Uy vazifasini mustaqil bajarish bo'yicha yo'riqnoma:
                </div>
                <p class="text-xs text-slate-700 leading-relaxed">
                    Siz kiritgan topshiriq: <em>"${escapeHtml(text)}"</em>.<br><br>
                    <strong>Tavsiya etilgan qadamlar:</strong><br>
                    1. Avval mavzuning darslikdagi qoidasini bir marta diqqat bilan o'qib chiqing.<br>
                    2. Shartda nima so'ralayotganini tagiga chizing (masalan: fe'l zamonimi, noma'lum x mi?).<br>
                    3. Misolni qoralama daftarga o'zingiz yechib, keyin javob bilan solishtiring.
                </p>
            `;
            addXP(5);
        }

        // ------------------ 5. TEST TIZIMI VA BALL HISOBI ------------------
        function renderTestSubjectButtons() {
            const wrap = document.getElementById('test-subjects');
            wrap.innerHTML = '';
            Object.keys(QUIZ_DATA).forEach(key => {
                const subObj = SUBJECTS.find(s => s.id === key) || { name: key };
                const btn = document.createElement('button');
                btn.className = `px-3.5 py-1.5 rounded-lg text-xs font-bold transition border ${key === selectedTestSubject ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-700 border-slate-300 hover:border-blue-400'}`;
                btn.innerText = subObj.name;
                btn.onclick = () => {
                    selectedTestSubject = key;
                    currentQuestionIdx = 0;
                    testScore = 0;
                    renderTestSubjectButtons();
                    loadQuizQuestion();
                };
                wrap.appendChild(btn);
            });
        }

        function loadQuizQuestion() {
            document.getElementById('quiz-result-box').classList.add('hidden');
            document.getElementById('quiz-card').classList.remove('hidden');
            document.getElementById('quiz-explanation').classList.add('hidden');
            document.getElementById('quiz-next-btn').classList.add('hidden');
            document.getElementById('quiz-check-btn').classList.remove('hidden');

            const questions = QUIZ_DATA[selectedTestSubject] || [];
            if(questions.length === 0) return;

            const q = questions[currentQuestionIdx];
            document.getElementById('quiz-step').innerText = `Savol ${currentQuestionIdx + 1} / ${questions.length}`;
            
            const subObj = SUBJECTS.find(s => s.id === selectedTestSubject);
            document.getElementById('quiz-subject-badge').innerText = subObj ? subObj.name : selectedTestSubject;
            document.getElementById('quiz-question').innerText = q.q;

            selectedOptionIdx = null;
            const optContainer = document.getElementById('quiz-options');
            optContainer.innerHTML = '';

            q.options.forEach((opt, idx) => {
                const optBtn = document.createElement('div');
                optBtn.className = "quiz-opt p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 cursor-pointer text-xs sm:text-sm font-medium flex items-center gap-3 transition";
                optBtn.innerHTML = `
                    <div class="w-5 h-5 rounded-full border border-slate-300 flex items-center justify-center text-[10px] font-bold text-slate-500 opt-circle">${String.fromCharCode(65 + idx)}</div>
                    <span>${opt}</span>
                `;
                optBtn.onclick = () => selectOption(idx);
                optContainer.appendChild(optBtn);
            });
        }

        function selectOption(idx) {
            selectedOptionIdx = idx;
            const items = document.querySelectorAll('.quiz-opt');
            items.forEach((item, i) => {
                if (i === idx) {
                    item.className = "quiz-opt p-3 rounded-xl border-2 border-blue-600 bg-blue-50/50 cursor-pointer text-xs sm:text-sm font-semibold flex items-center gap-3 transition";
                } else {
                    item.className = "quiz-opt p-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 cursor-pointer text-xs sm:text-sm font-medium flex items-center gap-3 transition";
                }
            });
        }

        function checkCurrentAnswer() {
            if (selectedOptionIdx === null) {
                alert("Iltimos, avval variantlardan birini tanlang!");
                return;
            }
            const q = QUIZ_DATA[selectedTestSubject][currentQuestionIdx];
            const items = document.querySelectorAll('.quiz-opt');
            const expBox = document.getElementById('quiz-explanation');

            if (selectedOptionIdx === q.correct) {
                items[selectedOptionIdx].className = "quiz-opt p-3 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-emerald-900 font-bold flex items-center gap-3";
                testScore++;
                addXP(20);
                expBox.innerHTML = `<strong>To'g'ri!</strong> ${q.exp}`;
            } else {
                items[selectedOptionIdx].className = "quiz-opt p-3 rounded-xl border-2 border-rose-500 bg-rose-50 text-rose-900 font-bold flex items-center gap-3";
                items[q.correct].className = "quiz-opt p-3 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-emerald-900 font-bold flex items-center gap-3";
                expBox.innerHTML = `<strong>Noto'g'ri.</strong> To'g'ri javob tahlili: ${q.exp}`;
            }

            expBox.classList.remove('hidden');
            document.getElementById('quiz-check-btn').classList.add('hidden');
            document.getElementById('quiz-next-btn').classList.remove('hidden');
        }

        function nextQuestion() {
            const questions = QUIZ_DATA[selectedTestSubject];
            if (currentQuestionIdx < questions.length - 1) {
                currentQuestionIdx++;
                loadQuizQuestion();
            } else {
                finishQuiz();
            }
        }

        function finishQuiz() {
            document.getElementById('quiz-card').classList.add('hidden');
            const resBox = document.getElementById('quiz-result-box');
            resBox.classList.remove('hidden');
            
            const total = QUIZ_DATA[selectedTestSubject].length;
            const percent = Math.round((testScore / total) * 100);
            document.getElementById('quiz-score-text').innerText = `Siz ${total} ta savoldan ${testScore} tasiga to'g'ri javob berdingiz (${percent}% aniqlik).`;

            saveTestRecord(selectedTestSubject, testScore, total);
        }

        function restartQuiz() {
            currentQuestionIdx = 0;
            testScore = 0;
            loadQuizQuestion();
        }

        // ------------------ 6. IMTIHON REJASI GENERATORI ------------------
        function generatePlan() {
            const subject = document.getElementById('plan-subject').value;
            const days = parseInt(document.getElementById('plan-days').value) || 7;
            const result = document.getElementById('plan-result');

            result.classList.remove('hidden');
            let html = `<h4 class="font-bold text-blue-900 text-sm mb-2">${subject} fanidan ${days} kunlik imtihon dasturi:</h4>`;
            html += `<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">`;
            
            for (let d = 1; d <= days; d++) {
                let focus = d === days ? "Barcha mavzularni umumiy takrorlash va test sinovi" : `Asosiy qoidalar va ${d}-bob amaliy mashqlari`;
                html += `
                    <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-200">
                        <span class="font-bold text-blue-700">${d}-kun:</span> <span class="text-slate-700">${focus}</span>
                    </div>
                `;
            }
            html += `</div>`;
            result.innerHTML = html;
            addXP(10);
        }

        // ------------------ 7. STATISTIKA VA LOCALSTORAGE ------------------
        function loadUserData() {
            const xp = parseInt(localStorage.getItem('aimaktab_xp')) || 0;
            const tests = JSON.parse(localStorage.getItem('aimaktab_history')) || [];
            
            document.getElementById('user-xp').innerText = xp;
            document.getElementById('stat-xp').innerText = xp;
            document.getElementById('stat-tests').innerText = tests.length;

            let totalAcc = 0;
            if (tests.length > 0) {
                const sum = tests.reduce((acc, cur) => acc + (cur.score / cur.total), 0);
                totalAcc = Math.round((sum / tests.length) * 100);
            }
            document.getElementById('stat-accuracy').innerText = `${totalAcc}%`;

            // Daraja
            let level = "1-daraja (Boshlang'ich)";
            if (xp > 200) level = "4-daraja (Bilimdon)";
            else if (xp > 100) level = "3-daraja (Izlanuvchi)";
            else if (xp > 40) level = "2-daraja (O'quvchi)";
            document.getElementById('stat-level').innerText = level;

            // Tarix ro'yxati
            const list = document.getElementById('test-history-list');
            if (tests.length === 0) {
                list.innerHTML = `<p class="text-slate-400 italic">Hali test topshirilmadi. Yuqoridagi bo'limdan test yeching!</p>`;
            } else {
                list.innerHTML = '';
                tests.slice(-4).reverse().forEach(t => {
                    const row = document.createElement('div');
                    row.className = "flex justify-between items-center p-2 rounded-lg bg-white border border-slate-200";
                    row.innerHTML = `
                        <span class="font-bold text-slate-800">${t.subjectName}</span>
                        <span class="text-slate-500">${t.score}/${t.total} to'g'ri (${Math.round(t.score/t.total*100)}%)</span>
                        <span class="text-emerald-600 font-semibold">+${t.score * 20} XP</span>
                    `;
                    list.appendChild(row);
                });
            }
        }

        function addXP(amount) {
            let xp = parseInt(localStorage.getItem('aimaktab_xp')) || 0;
            xp += amount;
            localStorage.setItem('aimaktab_xp', xp);
            loadUserData();
        }

        function saveTestRecord(subKey, score, total) {
            const tests = JSON.parse(localStorage.getItem('aimaktab_history')) || [];
            const subObj = SUBJECTS.find(s => s.id === subKey);
            tests.push({
                subject: subKey,
                subjectName: subObj ? subObj.name : subKey,
                score: score,
                total: total,
                date: new Date().toLocaleDateString('uz-UZ')
            });
            localStorage.setItem('aimaktab_history', JSON.stringify(tests));
            loadUserData();
        }

        function resetStats() {
            if (confirm("Haqiqatan ham barcha test natijalari va to'plangan ballarni o'chirmoqchimisiz?")) {
                localStorage.removeItem('aimaktab_xp');
                localStorage.removeItem('aimaktab_history');
                loadUserData();
            }
        }

        function saveApiKey() {
            const key = document.getElementById('custom-api-key').value.trim();
            if(key) {
                localStorage.setItem('aimaktab_api_key', key);
                document.getElementById('active-engine-badge').innerText = "Tashqi AI Ulandi";
                alert("API kalit saqlandi! Endi AI Ustoz jonli modelda ishlaydi.");
            } else {
                localStorage.removeItem('aimaktab_api_key');
                document.getElementById('active-engine-badge').innerText = "Oflayn Milliy Baza";
                alert("API kalit olib tashlandi. Tizim oflayn milliy bazaga qaytdi.");
            }
            toggleModal('api-modal');
        }

        function openPremiumInfo() {
            alert("AI Maktab Pro: O'zbekistonning eng iqtidorli o'quvchilari uchun qo'shimcha resurslar. Hozirgi barcha darslar va testlar BEPUL rejimda ham to'liq ishlaydi!");
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>
</body>
</html>
